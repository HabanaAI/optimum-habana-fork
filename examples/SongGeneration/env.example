# SongGeneration API Server Configuration
# Copy this file to .env and modify the values as needed

# ==========================================
# Server Configuration
# ==========================================

# API Server Port (default: 8485)
SERVER_PORT=8485

# Model directory name (must exist in the mounted models directory)
# Available models: songgeneration_base, songgeneration_base_new, songgeneration_base_full, songgeneration_large
MODEL_DIR=songgeneration_base_new

# Use Flash Attention (true/false)
USE_FLASH_ATTN=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==========================================
# Habana Device Configuration
# ==========================================

# Habana visible devices (all or specific device IDs like "0", "0,1", etc.)
HABANA_VISIBLE_DEVICES=all

# ==========================================
# Volume Mount Paths (Host -> Container)
# ==========================================

# Models directory - contains downloaded model weights
# This should be an absolute path or relative to docker-compose.yml
MODELS_HOST_PATH=./models

# Logs directory - for persistent logs outside container
LOGS_HOST_PATH=./logs

# Tools directory - contains new_prompt.pt file
TOOLS_HOST_PATH=./tools

# Third party directory - (Deprecated: now included in tools/runtime)
# THIRD_PARTY_HOST_PATH=./third_party

# Data directory - for persistent audio outputs
DATA_HOST_PATH=./data

# ==========================================
# Resource Configuration
# ==========================================

# Memory limit for the container (e.g., 32G, 64G)
MEMORY_LIMIT=32G

# ==========================================
# Example Model Preparation Commands
# ==========================================
# Run these commands on the host before starting the container:
#
# # Download new_prompt.pt
# wget https://media.githubusercontent.com/media/tencent-ailab/SongGeneration/refs/heads/main/tools/new_prompt.pt
# mv new_prompt.pt tools/
#
# # Download models
# huggingface-cli download lglg666/SongGeneration-base --local-dir ./models/songgeneration_base
# huggingface-cli download lglg666/SongGeneration-base-new --local-dir ./models/songgeneration_base_new
# huggingface-cli download lglg666/SongGeneration-base-full --local-dir ./models/songgeneration_base_full
# huggingface-cli download lglg666/SongGeneration-large --local-dir ./models/songgeneration_large
#
# # Download runtime dependencies
# huggingface-cli download lglg666/SongGeneration-Runtime --local-dir ./tools/runtime
