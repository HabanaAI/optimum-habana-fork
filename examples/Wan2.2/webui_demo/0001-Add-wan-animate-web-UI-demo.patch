+def run_gradio():
+    # Create pipe
+    cp_size = 8
+    for i in range(cp_size):
+        pipename = f"animate_fifo_{i}"
+        if os.path.exists(pipename):
+            os.unlink(pipename)
+        os.mkfifo(pipename)
+
+    pipename = "animate_fifo_result"
+    if not os.path.exists(pipename):
+        os.mkfifo(pipename)
+
+    # Open pipe
+    pipelist = []
+    for i in range(cp_size):
+        pipename = f"animate_fifo_{i}"
+        pipelist.append(os.open(pipename, os.O_WRONLY))
+    result_pipe = os.open("animate_fifo_result", os.O_RDONLY)
+
+    def broadcast_args(message):
+        for pipe in pipelist:
+            os.write(pipe, message.encode())
+
+    def read_result():
+        return os.read(result_pipe, 16384).decode()
+
+    @spaces.GPU(duration=get_duration)
+    def _preprocess(input_video, max_duration_s, edited_frame, rc_bool, pts_by_frame, lbs_by_frame, session_id=None, progress=gr.Progress(track_tqdm=True)):
+        if session_id is None:
+            session_id = uuid.uuid4().hex
+
