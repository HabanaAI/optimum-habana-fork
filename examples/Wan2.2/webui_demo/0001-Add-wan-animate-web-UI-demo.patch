+def get_select_coords(prompt_state, frames, frame_idx, img_path, evt: gr.SelectData):
+    img = np.array(frames[frame_idx])
+
+    # y, x from the event
+    i = evt.index[1]
+    j = evt.index[0]
+
+    # make sure we're editing the correct frame
